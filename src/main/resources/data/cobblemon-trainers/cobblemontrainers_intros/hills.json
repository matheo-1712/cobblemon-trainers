{
  "duration": 100,
  "fadeIn": 4,
  "fadeOut": 8,
  "layers": [
    { "type": "fill", "color": "#0A0D12", "alpha": 0.88, "from": "fade", "for": 4 },

    { "type": "fill", "color": "#2F6FBF", "alpha": 0.5, "slant": 0.2,
      "width": 126, "offset": [-128, 0], "from": "top", "for": 20 },
    { "type": "fill", "color": "#6E7B8B", "alpha": 0.5, "slant": 0.2,
      "width": 126, "offset": [128, 0], "from": "top", "for": 20 },

    { "type": "fill", "color": "#DCE6F0", "alpha": 0.85, "height": 4,
      "at": 20, "for": 6, "from": "pop" },

    { "type": "figure", "who": "player", "height": 150, "yaw": 22,
      "offset": [-128, 0], "from": "top", "for": 22 },
    { "type": "figure", "who": "trainer", "height": 150, "yaw": -22,
      "offset": [128, 0], "from": "top", "for": 22 },

    { "type": "text", "value": "%player%", "offset": [-128, -95], "at": 22, "for": 6 },
    { "type": "text", "value": "%name%", "color": "#DCE6F0", "offset": [128, -95], "at": 22, "for": 6 },

    { "type": "team_balls", "who": "player", "size": 1.5, "offset": [-128, 85], "at": 24, "for": 6 },
    { "type": "team_balls", "who": "trainer", "size": 1.5, "offset": [128, 85], "at": 24, "for": 6 },

    { "type": "vs", "size": 4, "color": "#DCE6F0", "at": 22, "for": 6, "from": "top" }
  ]
}
