{
  "duration": 90,
  "fadeIn": 2,
  "fadeOut": 6,
  "layers": [
    { "type": "fill", "color": "#120C05", "alpha": 0.9, "from": "fade", "for": 2 },

    { "type": "fill", "color": "#2F6FBF", "alpha": 0.5, "width": 120,
      "offset": [-128, 0], "from": "left", "for": 12, "ease": "linear" },
    { "type": "fill", "color": "#C99A3E", "alpha": 0.5, "width": 120,
      "offset": [128, 0], "from": "right", "for": 12, "ease": "linear" },

    { "type": "fill", "color": "#FFE9B0", "alpha": 0.95, "height": 6,
      "at": 12, "for": 4, "from": "pop" },

    { "type": "figure", "who": "player", "height": 150, "yaw": 22,
      "offset": [-128, 0], "from": "left", "for": 12, "ease": "linear" },
    { "type": "figure", "who": "trainer", "height": 150, "yaw": -22,
      "offset": [128, 0], "from": "right", "for": 12, "ease": "linear" },

    { "type": "text", "value": "%player%", "offset": [-128, -95], "at": 12, "for": 4 },
    { "type": "text", "value": "%name%", "color": "#FFE9B0", "offset": [128, -95], "at": 12, "for": 4 },

    { "type": "team_balls", "who": "player", "size": 1.5, "offset": [-128, 85], "at": 14, "for": 4 },
    { "type": "team_balls", "who": "trainer", "size": 1.5, "offset": [128, 85], "at": 14, "for": 4 },

    { "type": "vs", "size": 5, "color": "#FFE9B0", "at": 12, "for": 4, "from": "pop" }
  ]
}
