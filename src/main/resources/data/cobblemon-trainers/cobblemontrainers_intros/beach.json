{
  "duration": 100,
  "fadeIn": 4,
  "fadeOut": 8,
  "layers": [
    { "type": "fill", "color": "#04101A", "alpha": 0.86, "from": "fade", "for": 4 },
    { "type": "fill", "color": "#2FA8A0", "alpha": 0.22, "height": 70,
      "offset": [0, 18], "from": "fade", "for": 12 },

    { "type": "fill", "color": "#2F6FBF", "alpha": 0.5, "slant": 0.6,
      "width": 124, "offset": [-128, 0], "from": "left", "for": 20 },
    { "type": "fill", "color": "#2FA8A0", "alpha": 0.5, "slant": 0.6,
      "width": 124, "offset": [128, 0], "from": "right", "for": 20 },

    { "type": "fill", "color": "#EAF7F5", "alpha": 0.85, "height": 5,
      "offset": [0, 18], "at": 20, "for": 8, "from": "pop" },

    { "type": "figure", "who": "player", "height": 150, "yaw": 22,
      "offset": [-128, 0], "from": "left", "for": 20 },
    { "type": "figure", "who": "trainer", "height": 150, "yaw": -22,
      "offset": [128, 0], "from": "right", "for": 20 },

    { "type": "text", "value": "%player%", "offset": [-128, -95], "at": 20, "for": 8 },
    { "type": "text", "value": "%name%", "color": "#BFF0EA", "offset": [128, -95], "at": 20, "for": 8 },

    { "type": "team_balls", "who": "player", "size": 1.5, "offset": [-128, 85], "at": 22, "for": 8 },
    { "type": "team_balls", "who": "trainer", "size": 1.5, "offset": [128, 85], "at": 22, "for": 8 },

    { "type": "vs", "size": 4, "color": "#EAF7F5", "at": 20, "for": 8, "from": "pop" }
  ]
